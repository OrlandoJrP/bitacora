# ─────────────────────────────────────────────────────────────────────────────
# Bitácora · Variables de entorno
# Copia este archivo a `.env.local` para desarrollo. NUNCA commitees `.env`.
# En DigitalOcean App Platform define estas variables en el panel (App-Level Envs).
# ─────────────────────────────────────────────────────────────────────────────

# Conexión a PostgreSQL. En DO Managed Postgres se inyecta automáticamente al
# adjuntar la base de datos (variable ${db.DATABASE_URL}). Debe usar SSL.
# Formato: postgresql://user:pass@host:port/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bitacora?sslmode=disable"

# Secreto para firmar las sesiones JWT de Auth.js.
# Genéralo con: openssl rand -base64 32
AUTH_SECRET="reemplaza-esto-por-un-secreto-largo-y-aleatorio"

# URL canónica de la app (sin slash final). En producción: el subdominio real.
AUTH_URL="http://localhost:3000"
# NextAuth v5 también lee NEXTAUTH_URL en algunos contextos; mantenlas iguales.
NEXTAUTH_URL="http://localhost:3000"

# Confía en el host detrás del proxy de App Platform.
AUTH_TRUST_HOST="true"

# ── Cuenta maestra (administrador / operador) — solo se usan en el SEED ──
ADMIN_EMAIL="admin@brujulamarkets.com"
ADMIN_INITIAL_PASSWORD="CambiaEstaClave123!"
